#!/usr/bin/env python3

import argparse
import json
import os
import re
import shutil
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any


@dataclass(kw_only=True)
class ClaudeConfig:
    claude_json_path: Path
    projects_dir_path: Path
    history_jsonl_path: Path


def claude_config() -> ClaudeConfig:
    claude_config_dir = os.environ.get("CLAUDE_CONFIG_DIR")

    if claude_config_dir:
        config_dir = Path(claude_config_dir)
    else:
        config_dir = Path.home() / ".claude_code"

    return ClaudeConfig(
        claude_json_path=config_dir / ".claude.json",
        projects_dir_path=config_dir / "projects",
        history_jsonl_path=config_dir / "history.jsonl",
    )


def load_claude_json(claude_json_path: Path) -> dict[str, Any] | None:
    if not claude_json_path.exists():
        print(f"Error: .claude.json not found: {claude_json_path}", file=sys.stderr)
        return None

    try:
        with open(claude_json_path, "r") as config_file:
            return json.load(config_file)
    except json.JSONDecodeError as error:
        print(
            f"Error: Failed to parse JSON from {claude_json_path}: {error}",
            file=sys.stderr,
        )
        return None
    except Exception as error:
        print(f"Error: Failed to read {claude_json_path}: {error}", file=sys.stderr)
        return None


def safe_path_string(path: str) -> str:
    normalized_path = os.path.abspath(os.path.expanduser(path))
    # This is how current Calude Code implemented.
    # This means if path contains non-alphanumeric characters,
    # directory in `projects` may conflict.
    return re.sub(r"[^a-zA-Z0-9]", "-", normalized_path)


def list_projects() -> bool:
    config = claude_config()

    claude_json = load_claude_json(config.claude_json_path)
    if claude_json is None:
        return False

    projects: dict[str, Any] = claude_json.get("projects", {})
    if not projects:
        print("No projects found.")
        return True

    for project_path in sorted(projects.keys()):
        print(f"* {project_path}")

    return True


def delete_project(project_path: str, *, dry_run: bool = False) -> bool:
    config = claude_config()

    project_path = os.path.abspath(os.path.expanduser(project_path))

    print(f"Use .claude.json: {config.claude_json_path}")
    print(f"Use projects directory: {config.projects_dir_path}")

    claude_json = load_claude_json(config.claude_json_path)
    if claude_json is None:
        return False

    if "projects" not in claude_json:
        print("Error: 'projects' key not found in .claude.json", file=sys.stderr)
        return False

    if project_path not in claude_json["projects"]:
        print(
            f"Error: Project '{project_path}' not found in .claude.json",
            file=sys.stderr,
        )
        return False

    # Collect the project itself plus any sub-directory projects nested under it.
    path_prefix = project_path + os.sep
    target_paths = [project_path] + sorted(
        project_path
        for project_path in claude_json["projects"]
        if project_path.startswith(path_prefix)
    )

    dir_name = safe_path_string(project_path)

    # Collect the project directories in projects/ to delete.
    dir_name_prefix = dir_name + "-"
    target_dirs: list[Path] = []
    if config.projects_dir_path.exists():
        for dir in sorted(config.projects_dir_path.iterdir()):
            if dir.name == dir_name or dir.name.startswith(dir_name_prefix):
                target_dirs.append(dir)

    # Remove from JSON config
    if dry_run:
        for target_path in target_paths:
            print(f"Project can be removed from .claude.json: {target_path}")
    else:
        for target_path in target_paths:
            del claude_json["projects"][target_path]
        try:
            with open(config.claude_json_path, "w") as config_file:
                # Preserve the default `.claude.json` formatting.
                json.dump(claude_json, config_file, indent=2)
        except Exception as error:
            print(
                f"Error: Failed to write to {config.claude_json_path}: {error}",
                file=sys.stderr,
            )
            return False
        for target_path in target_paths:
            print(f"Removed project from .claude.json: {target_path}")

    # Remove project directories
    if not target_dirs:
        print(
            f"Project directory not found, may have been already removed: {config.projects_dir_path / dir_name}"
        )
    for dir in target_dirs:
        if dry_run:
            print(f"Project directory can be removed: {dir}")
        else:
            try:
                shutil.rmtree(dir)
                print(f"Removed project directory: {dir}")
            except Exception as error:
                print(
                    f"Error: Failed to remove directory {dir}: {error}",
                    file=sys.stderr,
                )
                return False

    # Remove command history
    for target_path in target_paths:
        if not update_history(config.history_jsonl_path, target_path, dry_run=dry_run):
            return False

    return True


def update_history(
    history_jsonl: Path,
    project_path: str,
    new_project_path: str | None = None,
    *,
    dry_run: bool = False,
) -> bool:
    removing = new_project_path is None

    if not history_jsonl.exists():
        print(f"History file not found, nothing to update: {history_jsonl}")
        return True

    try:
        with open(history_jsonl, "r") as history_file:
            lines = history_file.readlines()
    except Exception as error:
        print(f"Error: Failed to read {history_jsonl}: {error}", file=sys.stderr)
        return False

    updated_lines: list[str] = []
    count = 0
    for line in lines:
        stripped = line.strip()
        if not stripped:
            updated_lines.append(line)
            continue

        try:
            entry = json.loads(stripped)
        except json.JSONDecodeError:
            # Preserve any line we can't parse as-is.
            updated_lines.append(line)
            continue

        if entry.get("project") != project_path:
            updated_lines.append(line)
            continue

        count += 1
        if removing:
            # Drop the line by not appending it.
            continue
        entry["project"] = new_project_path
        # Match Claude Code's compact, non-ASCII-escaped JSONL format.
        updated_lines.append(
            json.dumps(entry, ensure_ascii=False, separators=(",", ":")) + "\n"
        )

    if count == 0:
        print(f"No history entries to update in: {history_jsonl}")
        return True

    if dry_run:
        print(f"{count} history entries can be updated in: {history_jsonl}")
        return True

    try:
        with open(history_jsonl, "w") as history_file:
            history_file.writelines(updated_lines)
        print(f"Updated {count} history entries in: {history_jsonl}")
    except Exception as error:
        print(f"Error: Failed to write to {history_jsonl}: {error}", file=sys.stderr)
        return False

    return True


def move_project(
    source_path: str, destination_path: str, *, dry_run: bool = False
) -> bool:
    config = claude_config()

    source_path = os.path.abspath(os.path.expanduser(source_path))
    destination_path = os.path.abspath(os.path.expanduser(destination_path))

    print(f"Use .claude.json: {config.claude_json_path}")
    print(f"Use projects directory: {config.projects_dir_path}")

    if source_path == destination_path:
        print(
            "Error: Source and destination paths are the same.",
            file=sys.stderr,
        )
        return False

    claude_json = load_claude_json(config.claude_json_path)
    if claude_json is None:
        return False

    if "projects" not in claude_json:
        print("Error: 'projects' key not found in .claude.json", file=sys.stderr)
        return False

    if source_path not in claude_json["projects"]:
        print(
            f"Error: Project '{source_path}' not found in .claude.json",
            file=sys.stderr,
        )
        return False

    source_dir_name = safe_path_string(source_path)
    destination_dir_name = safe_path_string(destination_path)

    # Collect the project itself plus any sub-directory projects nested under it.
    path_prefix = source_path + os.sep
    path_moves: list[tuple[str, str]] = [(source_path, destination_path)]
    for source_sub_path in sorted(
        project_path
        for project_path in claude_json["projects"]
        if project_path.startswith(path_prefix)
    ):
        destination_sub_path = destination_path + source_sub_path[len(source_path) :]
        path_moves.append((source_sub_path, destination_sub_path))

    # Collect the project directories in projects/ to move.
    dir_name_prefix = source_dir_name + "-"
    dir_moves: list[tuple[Path, Path]] = []
    if config.projects_dir_path.exists():
        for dir in sorted(config.projects_dir_path.iterdir()):
            if dir.name == source_dir_name or dir.name.startswith(dir_name_prefix):
                name = destination_dir_name + dir.name[len(source_dir_name) :]
                dir_moves.append((dir, config.projects_dir_path / name))

    # Validate every destination up front so we don't move some and then fail.
    for _, dst in path_moves:
        if dst in claude_json["projects"]:
            print(
                f"Error: Destination project '{dst}' already exists in .claude.json",
                file=sys.stderr,
            )
            return False
    for _, dst in dir_moves:
        if dst.exists():
            print(
                f"Error: Destination project directory already exists: {dst}",
                file=sys.stderr,
            )
            return False

    # Update JSON config
    if dry_run:
        for src, dst in path_moves:
            print(f"Project can be moved in .claude.json: {src} -> {dst}")
    else:
        for src, dst in path_moves:
            claude_json["projects"][dst] = claude_json["projects"][src]
            del claude_json["projects"][src]
        try:
            with open(config.claude_json_path, "w") as config_file:
                # Preserve the default `.claude.json` formatting.
                json.dump(claude_json, config_file, indent=2)
        except Exception as error:
            print(
                f"Error: Failed to write to {config.claude_json_path}: {error}",
                file=sys.stderr,
            )
            return False
        for src, dst in path_moves:
            print(f"Moved project in .claude.json: {src} -> {dst}")

    # Move project directories
    if not dir_moves:
        print(
            f"Project directory not found, nothing to move: {config.projects_dir_path / source_dir_name}"
        )
    for src, dst in dir_moves:
        if dry_run:
            print(f"Project directory can be moved: {src} -> {dst}")
        else:
            try:
                shutil.move(str(src), str(dst))
                print(f"Moved project directory: {src} -> {dst}")
            except Exception as error:
                print(
                    f"Error: Failed to move directory {src} -> {dst}: {error}",
                    file=sys.stderr,
                )
                return False

    # Migrate command history
    for src, dst in path_moves:
        if not update_history(config.history_jsonl_path, src, dst, dry_run=dry_run):
            return False

    return True


def main() -> None:
    parser = argparse.ArgumentParser(description="Manage Claude Code projects")
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("list", aliases=["ls"], help="List all projects")

    delete_parser = subparsers.add_parser(
        "delete", aliases=["rm"], help="Delete a project from configuration"
    )
    delete_parser.add_argument(
        "project_path",
        nargs="?",
        default=".",
        help="Path to the project to delete (default: current directory)",
    )
    delete_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would be done without making any changes",
    )

    move_parser = subparsers.add_parser(
        "move", aliases=["mv"], help="Move a project to a new path in configuration"
    )
    move_parser.add_argument(
        "source_path",
        help="Current path of the project",
    )
    move_parser.add_argument(
        "destination_path",
        help="New path of the project",
    )
    move_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would be done without making any changes",
    )

    args = parser.parse_args()

    match args.command:
        case "list" | "ls":
            success = list_projects()
        case "delete" | "rm":
            success = delete_project(args.project_path, dry_run=args.dry_run)
        case "move" | "mv":
            success = move_project(
                args.source_path, args.destination_path, dry_run=args.dry_run
            )
        case _:
            parser.print_help()
            success = False

    sys.exit(0 if success else 1)


if __name__ == "__main__":
    main()
